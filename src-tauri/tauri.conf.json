{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrierenPet",
  "version": "0.1.0",
  "identifier": "com.example.frierenpet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Frieren Pet",
        "url": "index.html#/",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "resizable": false,
        "maximizable": false,
        "width": 442,
        "height": 442,
        "center": true
      },
      {
        "label": "preference",
        "title": "设置",
        "url": "index.html#/preference/pets",
        "visible": false,
        "width": 680,
        "height": 520,
        "minWidth": 600,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/pets/**/*",
      "assets/tray.png",
      "assets/tray-mac.png"
    ]
  }
}
